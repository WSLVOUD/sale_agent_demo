# DeepSeek API Configuration
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MODEL_NAME=deepseek-chat
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_API_BASE=https://api.deepseek.com

# Tavily Search Configuration (Optional - for web search)
# 获取地址: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Vector Store Configuration
VECTORSTORE_DIR=./vectorstore

# Data Directory
DATA_DIR=./data

# Retrieval Configuration
TOP_K=5

# Text Splitting Configuration
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# ── Reflection 预算控制 ──
REFLECTION_MAX_ROUNDS=3
REFLECTION_MAX_TOKENS=2000
REFLECTION_MAX_TIME_MS=8000
REFLECTION_NO_IMPROVE_STOP=2

# ── 安全与可观测性 ──
# API 鉴权密钥（留空 = 开发模式不鉴权）
LED_API_KEY=
LLM_TIMEOUT_SECS=30
LLM_MAX_RETRIES=2

# ── v2.0 Phase 14：回复语言策略 ──
# en   = 始终英语回复（默认，保持既有行为）
# auto = 跟随客户语言回复
RESPONSE_LANGUAGE_POLICY=en
