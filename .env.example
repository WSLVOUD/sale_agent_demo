# DeepSeek API Configuration
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MODEL_NAME=deepseek-chat
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_API_BASE=https://api.deepseek.com

# Tavily Search Configuration (Optional - for web search)
# 获取地址: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Vector Store Configuration
VECTORSTORE_DIR=./vectorstore

# Data Directory
DATA_DIR=./data

# Retrieval Configuration
TOP_K=5

# ── 会话记忆窗口（客户口径 2026-09-21）────────────────────────────────────
# AI 带上最近多少条对话去理解整句话（意图分类 / 需求理解 / 话术都用它）：
#   HISTORY_LIMIT             最多取多少条（默认 50）
#   HISTORY_PER_MESSAGE_CHARS 单条截断字符数（默认 300）
#   HISTORY_TOTAL_CHARS       总量预算，真正限制上下文大小的是它（默认 6000）
LED_RAG_HISTORY_LIMIT=50
LED_RAG_HISTORY_PER_MESSAGE_CHARS=300
LED_RAG_HISTORY_TOTAL_CHARS=6000

# ── 不连续提问（客户口径 2026-09-22）──────────────────────────────────────
# 客户没回答上一问时，最多允许"只承接、不提问"几条；下一条必须回归需求提问。
# 客户口径："承接三条改成承接一条，第二条必须回归有需求提问的那句话"
LED_RAG_MAX_ACK_STREAK=1

# Text Splitting Configuration
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# ── Reflection 预算控制 ──
REFLECTION_MAX_ROUNDS=3
REFLECTION_MAX_TOKENS=2000
REFLECTION_MAX_TIME_MS=8000
REFLECTION_NO_IMPROVE_STOP=2

# ── 安全与可观测性 ──
# API 鉴权密钥（留空 = 开发模式不鉴权）
LED_API_KEY=
LLM_TIMEOUT_SECS=30
LLM_MAX_RETRIES=2

# ── v2.0 Phase 14：回复语言策略 ──
# en   = 始终英语回复（默认，保持既有行为）
# auto = 跟随客户语言回复
RESPONSE_LANGUAGE_POLICY=en

# ── 智谱视觉需求提取（客户发图片时识别需求）──
# 智谱开放平台 API Key（https://open.bigmodel.cn）
GLM_API_KEY=
# 视觉模型（账号未开通该模型时会自动回退到其它 GLM-4V 系列）
GLM_VISION_MODEL=glm-4v-plus
# 接口地址
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
# 总开关（false = 完全忽略图片，不影响原有文字流程）
VISION_ENABLED=true
# 超时 / 重试
VISION_TIMEOUT_SECS=40
VISION_MAX_RETRIES=1
# 安全限制：单次最多几张图 / 单张最大 MB
VISION_MAX_IMAGES=3
VISION_MAX_IMAGE_MB=5
