{
  "schema_version": "1.0",
  "created": "2026-09-13",
  "phase": "Phase 0 - 建立评估基线",
  "description": "LED 智能选型 Golden Dataset。覆盖室内/室外、固装/租赁、会议室/教室/展厅/商场/广告/舞台/演唱会、模糊需求、多轮需求、多语言、指定点间距、指定尺寸、不完整需求与冲突需求；v2.1 追加客户决策状态边界样本（g073~g082：授权 AI 决定 DELEGATED / 不知道 UNKNOWN / 延后 DEFERRED / 拒绝 DECLINED / 真阻塞 BLOCKED）。每条用例同时给出 Series 级与 Model 级期望，便于 Phase 2 前后直接对比。",
  "field_notes": {
    "hard": "硬约束：命中即违规，检索与推荐都必须满足",
    "slots": "期望的结构化需求槽位（Requirement Slot Accuracy 的分母）",
    "series": "可接受的 Series ID 集合（Recall@K / MRR 的计算基准）",
    "models": "可接受的 Model 集合；为空表示当前信息不足以确定型号，不参与 Model 级指标",
    "route": "期望路由：fast（纯参数）/ normal（明确条件推荐）/ agent（需要推理）",
    "decision": "v2.1 字段决策状态期望（可选）：slot → CONFIRMED / INFERRED / UNKNOWN / DELEGATED / DECLINED / DEFERRED，以及该轮 Gate 状态（READY / DEGRADED_READY / CONTINUE_ASKING / BLOCKED）与应执行的 Action"
  },
  "targets": {
    "requirement_slot_accuracy": 0.9,
    "recall_at_5": 0.8,
    "recall_at_10": 0.9,
    "mrr": 0.8,
    "top1_recommendation_accuracy": 0.85,
    "top3_recommendation_coverage": 0.95,
    "hard_constraint_violation": 0.0,
    "calculator_accuracy": 1.0
  },
